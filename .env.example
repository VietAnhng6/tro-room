# TroRoom - Biến môi trường (template)
# Sao chép file này thành ".env" và điền giá trị thật.
# File ".env" KHÔNG được commit (đã nằm trong .gitignore).

# Mật khẩu PostgreSQL
DB_PASSWORD=

# Tài khoản Gmail dùng để gửi email (SMTP)
MAIL_USERNAME=
MAIL_PASSWORD=

# Khoá ký JWT (chuỗi ngẫu nhiên >= 32 byte, dùng cho HS256)
# Có thể sinh bằng lệnh: openssl rand -hex 48
JWT_SECRET=

# Base URL dùng để tạo link trong email (tuỳ chọn)
APP_BASE_URL=http://localhost:5173
